{
  "name": "@emplio/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "openui:generate": "openui generate src/lib/openui.ts -o ../shared/openui/system-prompt.txt --no-interactive --no-telemetry && rm -f ../shared/openui/system-prompt.spec.json",
    "prebuild": "bun run cloud:assets && bun run openui:generate",
    "cloud:assets": "rm -rf public/cloud && if [ -d ../cloud/frontend/public ]; then cp -R ../cloud/frontend/public public/cloud; fi",
    "predev": "bun run cloud:assets"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.150",
    "@base-ui/react": "^1.9.0",
    "@emplio/shared": "workspace:*",
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-lang": "^1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.104.5",
    "ai": "7.0.146",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "pdfjs-dist": "^6.5.438",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@openuidev/cli": "^0.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.10",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
